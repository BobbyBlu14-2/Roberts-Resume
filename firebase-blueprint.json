{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and workspace metadata for dashboard access.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Authentication user UID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "User display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "description": "Verified user email address."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional profile avatar URL."
        },
        "organization": {
          "type": "string",
          "maxLength": 100,
          "description": "Client company or organization name."
        },
        "role": {
          "type": "string",
          "enum": ["member", "admin"],
          "description": "Account access role."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update."
        }
      },
      "required": ["uid", "displayName", "email", "organization", "role", "createdAt", "updatedAt"]
    },
    "CampaignMetric": {
      "title": "CampaignMetric",
      "description": "Interactive marketing campaign and digital analytics entry owned by a user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the owning user."
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Campaign or initiative name."
        },
        "channel": {
          "type": "string",
          "enum": ["SEO/SEM", "Social Media", "E-Commerce", "Email Funnel", "Brand Strategy", "Web/App"],
          "description": "Marketing or engineering channel."
        },
        "status": {
          "type": "string",
          "enum": ["Active", "Planned", "Paused", "Completed"],
          "description": "Current campaign lifecycle status."
        },
        "impressions": {
          "type": "number",
          "description": "Total campaign impressions."
        },
        "leads": {
          "type": "number",
          "description": "Qualified leads captured."
        },
        "conversions": {
          "type": "number",
          "description": "Completed sales or conversion actions."
        },
        "spend": {
          "type": "number",
          "description": "Marketing spend in USD."
        },
        "revenue": {
          "type": "number",
          "description": "Attributed revenue in USD."
        },
        "periodDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Reporting date in YYYY-MM-DD format."
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional campaign optimization notes."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last modification."
        }
      },
      "required": [
        "ownerId",
        "title",
        "channel",
        "status",
        "impressions",
        "leads",
        "conversions",
        "spend",
        "revenue",
        "periodDate",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    },
    "ContactInquiry": {
      "title": "ContactInquiry",
      "description": "Authenticated project consultation or marketing inquiry submitted to Blu Marketing Group.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the submitting user."
        },
        "senderName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Full name of the requester."
        },
        "senderEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "description": "Verified contact email."
        },
        "serviceType": {
          "type": "string",
          "enum": ["Brand Strategy", "SEO/SEM & Lead Gen", "E-Commerce", "Web & App Dev", "Full Retainer"],
          "description": "Requested service discipline."
        },
        "budgetTier": {
          "type": "string",
          "enum": ["Under $2.5k", "$2.5k - $10k", "$10k - $25k", "$25k+"],
          "description": "Estimated project budget range."
        },
        "message": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1200,
          "description": "Project details and goals."
        },
        "status": {
          "type": "string",
          "enum": ["Submitted", "Reviewed", "Archived"],
          "description": "Inquiry review state."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of inquiry submission."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of inquiry update."
        }
      },
      "required": [
        "ownerId",
        "senderName",
        "senderEmail",
        "serviceType",
        "budgetTier",
        "message",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account profiles indexed by Firebase Auth UID."
    },
    "/users/{userId}/campaigns/{campaignId}": {
      "schema": { "$ref": "#/entities/CampaignMetric" },
      "description": "Per-user interactive marketing and analytics campaign records."
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/ContactInquiry" },
      "description": "Project inquiries submitted by verified users."
    }
  }
}
