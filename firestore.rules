rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrappedAdmin() {
      return isEmailVerified() && request.auth.token.email == 'BluMarketingGrp@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isEmailVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'email', 'organization', 'role', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'organization', 'role', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        data.organization is string && data.organization.size() <= 100 &&
        data.role in ['member', 'admin'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCampaignMetric(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'title', 'channel', 'status', 'impressions', 'leads',
          'conversions', 'spend', 'revenue', 'periodDate', 'notes', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'title', 'channel', 'status', 'impressions', 'leads',
          'conversions', 'spend', 'revenue', 'periodDate', 'notes', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == userId &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 80 &&
        data.channel in ['SEO/SEM', 'Social Media', 'E-Commerce', 'Email Funnel', 'Brand Strategy', 'Web/App'] &&
        data.status in ['Active', 'Planned', 'Paused', 'Completed'] &&
        data.impressions is number && data.impressions >= 0 && data.impressions <= 100000000 &&
        data.leads is number && data.leads >= 0 && data.leads <= 10000000 &&
        data.conversions is number && data.conversions >= 0 && data.conversions <= 10000000 &&
        data.spend is number && data.spend >= 0 && data.spend <= 10000000 &&
        data.revenue is number && data.revenue >= 0 && data.revenue <= 100000000 &&
        data.periodDate is string && data.periodDate.size() == 10 &&
        data.periodDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.notes is string && data.notes.size() <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidContactInquiry(data) {
      return data.keys().hasAll([
          'ownerId', 'senderName', 'senderEmail', 'serviceType', 'budgetTier',
          'message', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'senderName', 'senderEmail', 'serviceType', 'budgetTier',
          'message', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.senderName is string && data.senderName.size() >= 2 && data.senderName.size() <= 80 &&
        data.senderEmail is string && data.senderEmail.size() >= 3 && data.senderEmail.size() <= 160 &&
        data.serviceType in ['Brand Strategy', 'SEO/SEM & Lead Gen', 'E-Commerce', 'Web & App Dev', 'Full Retainer'] &&
        data.budgetTier in ['Under $2.5k', '$2.5k - $10k', '$10k - $25k', '$25k+'] &&
        data.message is string && data.message.size() >= 10 && data.message.size() <= 1200 &&
        data.status in ['Submitted', 'Reviewed', 'Archived'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    // Admin registry (read-only by admins, managed out-of-band)
    match /admins/{adminId} {
      allow get: if isEmailVerified() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    // User profiles (Strict PII isolation)
    match /users/{userId} {
      allow get: if isEmailVerified() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;

      allow create: if isEmailVerified() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().role == 'member' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isEmailVerified() &&
        isValidId(userId) &&
        (isOwner(userId) || isAdmin()) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            incoming().role == existing().role &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'organization', 'photoURL', 'updatedAt'
            ])
          )
        );

      allow delete: if false;

      // User's Interactive Campaign Dashboard Records
      match /campaigns/{campaignId} {
        allow get: if isEmailVerified() && isValidId(userId) && isValidId(campaignId) && (isOwner(userId) || isAdmin());
        allow list: if isEmailVerified() && (
          (request.auth.uid == userId && resource.data.ownerId == request.auth.uid) ||
          isBootstrappedAdmin()
        );

        allow create: if isEmailVerified() &&
          isValidId(userId) &&
          isValidId(campaignId) &&
          isOwner(userId) &&
          isValidCampaignMetric(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isEmailVerified() &&
          isValidId(userId) &&
          isValidId(campaignId) &&
          (isOwner(userId) || isAdmin()) &&
          isValidCampaignMetric(incoming(), userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (existing().status != 'Completed' || isAdmin()) && (
            isAdmin() || (
              incoming().diff(existing()).affectedKeys().hasOnly([
                'title', 'channel', 'status', 'impressions', 'leads',
                'conversions', 'spend', 'revenue', 'periodDate', 'notes', 'updatedAt'
              ])
            )
          );

        allow delete: if isEmailVerified() &&
          isValidId(userId) &&
          isValidId(campaignId) &&
          (isOwner(userId) || isAdmin());
      }
    }

    // Verified Project Inquiries
    match /inquiries/{inquiryId} {
      allow get: if isEmailVerified() && isValidId(inquiryId) && (
        existing().ownerId == request.auth.uid || isAdmin()
      );
      allow list: if isEmailVerified() && (
        resource.data.ownerId == request.auth.uid || isBootstrappedAdmin()
      );

      allow create: if isEmailVerified() &&
        isValidId(inquiryId) &&
        isValidContactInquiry(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().status == 'Submitted' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isEmailVerified() &&
        isValidId(inquiryId) &&
        isAdmin() &&
        isValidContactInquiry(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        existing().status != 'Archived' &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isEmailVerified() && isValidId(inquiryId) && (
        existing().ownerId == request.auth.uid || isAdmin()
      );
    }
  }
}
